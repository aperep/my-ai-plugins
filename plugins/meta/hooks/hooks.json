{
  "description": "Guide and inventory project docs, and harvest reusable marketplace suggestions.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/auto-evolve-context.py\"",
            "additionalContextLimit": 500
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/project_docs_context.py\"",
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
