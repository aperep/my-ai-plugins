\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{interlinear}[2026/10/03 sentence-level research annotations]

\RequirePackage{xparse}
\RequirePackage{xcolor}
\RequirePackage[unicode]{hyperref}

\definecolor{InterlinearTranslation}{HTML}{315C9B}
\definecolor{InterlinearExplanation}{HTML}{555555}
\definecolor{InterlinearContext}{HTML}{6A4C93}
\definecolor{InterlinearFormal}{HTML}{2E7D32}

\ExplSyntaxOn
\prop_new:N \g_interlinear_translation_prop
\prop_new:N \g_interlinear_explanation_prop
\prop_new:N \g_interlinear_context_prop
\prop_new:N \g_interlinear_formal_prop
\prop_new:N \g_interlinear_reference_prop
\prop_new:N \g_interlinear_popup_prop
\seq_new:N \g_interlinear_labels_seq
\seq_new:N \g_interlinear_source_labels_seq
\clist_new:N \g_interlinear_focus_clist
\tl_new:N \g_interlinear_mode_tl
\tl_gset:Nn \g_interlinear_mode_tl { badges }

\msg_new:nnn {interlinear} {invalid-tag}
  {Interlinear~tag~'#1'~must~be~four~alphanumeric~characters.}
\msg_new:nnn {interlinear} {duplicate-tag}
  {Interlinear~tag~'#1'~is~used~more~than~once.}

\NewDocumentCommand{\InterlinearMode}{m}
  { \tl_gset:Nn \g_interlinear_mode_tl {#1} }
\NewDocumentCommand{\InterlinearFocus}{m}
  { \clist_gset:Nn \g_interlinear_focus_clist {#1} }

\NewDocumentCommand{\InterlinearDeclare}{mmmmmmm}
  {
    \seq_if_in:NnF \g_interlinear_labels_seq {#1}
      { \seq_gput_right:Nn \g_interlinear_labels_seq {#1} }
    \prop_gput:Nnn \g_interlinear_translation_prop {#1} {#2}
    \prop_gput:Nnn \g_interlinear_explanation_prop {#1} {#3}
    \prop_gput:Nnn \g_interlinear_context_prop {#1} {#4}
    \prop_gput:Nnn \g_interlinear_formal_prop {#1} {#5}
    \prop_gput:Nnn \g_interlinear_reference_prop {#1} {#6}
    \prop_gput:Nnn \g_interlinear_popup_prop {#1} {#7}
  }

\cs_new_protected:Npn \interlinear_prop_row:Nnnn #1#2#3#4
  {
    \prop_get:NnN #1 {#4} \l_tmpa_tl
    \tl_if_blank:VF \l_tmpa_tl
      {
        \par\noindent
        \textcolor{#2}{\textbf{#3}}\quad \l_tmpa_tl
      }
  }

\cs_new_protected:Npn \interlinear_rows:n #1
  {
    \interlinear_prop_row:Nnnn \g_interlinear_translation_prop
      {InterlinearTranslation} {Translation} {#1}
    \interlinear_prop_row:Nnnn \g_interlinear_explanation_prop
      {InterlinearExplanation} {Explanation} {#1}
    \interlinear_prop_row:Nnnn \g_interlinear_context_prop
      {InterlinearContext} {Active~context} {#1}
    \interlinear_prop_row:Nnnn \g_interlinear_formal_prop
      {InterlinearFormal} {Lean} {#1}
    \interlinear_prop_row:Nnnn \g_interlinear_reference_prop
      {InterlinearExplanation} {Reference} {#1}
  }

\cs_new_protected:Npn \interlinear_badge:n #1
  {
    \nobreak\hspace{0.15em}
    \hyperlink{interlinear-ann-#1}
      {\textsuperscript{\textcolor{InterlinearTranslation}{\textsf{ann}}}}
  }

\cs_new_protected:Npn \interlinear_inline:n #1
  {
    \par\smallskip\noindent
    \fcolorbox{InterlinearTranslation!35}{InterlinearTranslation!3}
      {
        \begin{minipage}{0.92\linewidth}
          \small\raggedright\interlinear_rows:n {#1}
        \end{minipage}
      }
    \par\smallskip
  }

\cs_new_protected:Npn \interlinear_footnote:n #1
  {
    \prop_get:NnN \g_interlinear_translation_prop {#1} \l_tmpa_tl
    \tl_if_blank:VF \l_tmpa_tl {\footnote{\l_tmpa_tl}}
  }

\cs_new_protected:Npn \interlinear_popup:n #1
  {
    \ifdefined\pdfannot
      \prop_get:NnN \g_interlinear_popup_prop {#1} \l_tmpa_tl
      \leavevmode
      \pdfannot width 1em height 1em depth .2em
        {
          /Subtype~/Text~/Name~/Comment
          /Contents~<\l_tmpa_tl>
          /C~[0.19~0.36~0.61]~/Open~false
        }
      \hspace{1.1em}
    \else
      \interlinear_badge:n {#1}
    \fi
  }

\cs_new_protected:Npn \interlinear_after:n #1
  {
    \str_case:VnF \g_interlinear_mode_tl
      {
        {plain}    { }
        {badges}   { \interlinear_badge:n {#1} }
        {inline}   { \interlinear_inline:n {#1} }
        {footnote} { \interlinear_footnote:n {#1} }
        {popup}    { \interlinear_popup:n {#1} }
        {focus}
          {
            \interlinear_badge:n {#1}
            \clist_if_in:NnT \g_interlinear_focus_clist {#1}
              { \interlinear_inline:n {#1} }
          }
      }
      { \interlinear_badge:n {#1} }
  }

\cs_new_protected:Npn \interlinear_tag:n #1
  {
    \regex_match:nnTF {\A[A-Za-z0-9]{4}\Z} {#1}
      {
        \seq_if_in:NnTF \g_interlinear_source_labels_seq {#1}
          { \msg_error:nnn {interlinear} {duplicate-tag} {#1} }
          {
            \seq_gput_right:Nn \g_interlinear_source_labels_seq {#1}
            \interlinear_after:n {#1}
          }
      }
      { \msg_error:nnn {interlinear} {invalid-tag} {#1} }
  }

\NewDocumentCommand{\itag}{m}{\interlinear_tag:n {#1}}

\NewDocumentCommand{\InterlinearPrintAppendix}{}
  {
    \section*{Annotation~appendix}
    \seq_map_inline:Nn \g_interlinear_labels_seq
      {
        \par\medskip\noindent
        \hypertarget{interlinear-ann-##1}{\textbf{\texttt{##1}}}
        \begingroup\raggedright\interlinear_rows:n {##1}\par\endgroup
      }
  }
\ExplSyntaxOff
