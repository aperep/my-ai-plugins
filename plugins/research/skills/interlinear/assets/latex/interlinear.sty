\NeedsTeXFormat{LaTeX2e}[2020-10-01]
\ProvidesPackage{interlinear}[2026/10/03 typed interlinear annotations]

\RequirePackage{xcolor}
\RequirePackage[unicode]{hyperref}

\definecolor{InterlinearTranslation}{HTML}{315C9B}
\definecolor{InterlinearExplanation}{HTML}{555555}
\definecolor{InterlinearContext}{HTML}{6A4C93}
\definecolor{InterlinearReference}{HTML}{8A5A00}
\definecolor{InterlinearFormal}{HTML}{2E7D32}
\definecolor{InterlinearExample}{HTML}{00796B}

\ExplSyntaxOn
\prop_new:N \g_interlinear_comment_prop
\prop_new:N \g_interlinear_qualifier_prop
\seq_new:N \g_interlinear_source_labels_seq
\clist_const:Nn \c_interlinear_types_clist
  { translation, explanation, context, reference, formal, example }
\clist_new:N \g_interlinear_focus_clist
\tl_new:N \g_interlinear_mode_tl
\tl_gset:Nn \g_interlinear_mode_tl { badges }

\msg_new:nnn {interlinear} {invalid-id}
  {Interlinear~ID~'#1'~must~be~four~alphanumeric~characters.}
\msg_new:nnn {interlinear} {unknown-type}
  {Unknown~interlinear~comment~type~'#1'.}
\msg_new:nnn {interlinear} {duplicate-comment}
  {Comment~type~'#2'~is~already~defined~for~ID~'#1'.}
\msg_new:nnn {interlinear} {duplicate-tag}
  {Interlinear~ID~'#1'~is~used~more~than~once~in~the~document.}

\NewDocumentCommand{\InterlinearMode}{m}
  { \tl_gset:Nn \g_interlinear_mode_tl {#1} }
\NewDocumentCommand{\InterlinearFocus}{m}
  { \clist_gset:Nn \g_interlinear_focus_clist {#1} }

\cs_new_protected:Npn \interlinear_comment:nnnn #1#2#3#4
  {
    \regex_match:nnTF {\A[A-Za-z0-9]{4}\Z} {#1}
      {
        \clist_if_in:NnTF \c_interlinear_types_clist {#2}
          {
            \prop_if_in:NnTF \g_interlinear_comment_prop {#1/#2}
              { \msg_error:nnnn {interlinear} {duplicate-comment} {#1} {#2} }
              {
                \prop_gput:Nnn \g_interlinear_comment_prop {#1/#2} {#4}
                \prop_gput:Nnn \g_interlinear_qualifier_prop {#1/#2} {#3}
              }
          }
          { \msg_error:nnn {interlinear} {unknown-type} {#2} }
      }
      { \msg_error:nnn {interlinear} {invalid-id} {#1} }
  }

\NewDocumentCommand{\ic}{mmO{}+m}
  { \interlinear_comment:nnnn {#1} {#2} {#3} {#4} }

\cs_new_protected:Npn \interlinear_comment_row:nn #1#2
  {
    \prop_get:NnNT \g_interlinear_comment_prop {#1/#2} \l_tmpa_tl
      {
        \prop_get:NnN \g_interlinear_qualifier_prop {#1/#2} \l_tmpb_tl
        \str_case:nn {#2}
          {
            {translation}
              { \tl_set:Nn \l_tmpc_tl {Translation}
                \tl_set:Nn \l_tmpd_tl {InterlinearTranslation} }
            {explanation}
              { \tl_set:Nn \l_tmpc_tl {Explanation}
                \tl_set:Nn \l_tmpd_tl {InterlinearExplanation} }
            {context}
              { \tl_set:Nn \l_tmpc_tl {Active~context}
                \tl_set:Nn \l_tmpd_tl {InterlinearContext} }
            {reference}
              { \tl_set:Nn \l_tmpc_tl {Reference}
                \tl_set:Nn \l_tmpd_tl {InterlinearReference} }
            {formal}
              { \tl_set:Nn \l_tmpc_tl {Formal}
                \tl_set:Nn \l_tmpd_tl {InterlinearFormal} }
            {example}
              { \tl_set:Nn \l_tmpc_tl {Example}
                \tl_set:Nn \l_tmpd_tl {InterlinearExample} }
          }
        \par\noindent
        \textcolor{\l_tmpd_tl}
          {\textbf{\l_tmpc_tl
            \tl_if_blank:VF \l_tmpb_tl {~(\l_tmpb_tl)}}}
        \quad \l_tmpa_tl
      }
  }

\cs_new_protected:Npn \interlinear_rows:n #1
  {
    \clist_map_inline:Nn \c_interlinear_types_clist
      { \interlinear_comment_row:nn {#1} {##1} }
  }

\cs_new_protected:Npn \interlinear_badge:n #1
  {
    \nobreak\hspace{0.15em}
    \hyperlink{interlinear-ann-#1}
      {\textsuperscript{\textcolor{InterlinearTranslation}{\textsf{ann}}}}
  }

\cs_new_protected:Npn \interlinear_inline:n #1
  {
    \par\smallskip\noindent
    \fcolorbox{InterlinearTranslation!35}{InterlinearTranslation!3}
      {
        \begin{minipage}{0.92\linewidth}
          \small\raggedright\interlinear_rows:n {#1}
        \end{minipage}
      }
    \par\smallskip
  }

\cs_new_protected:Npn \interlinear_footnote:n #1
  {
    \prop_get:NnNT \g_interlinear_comment_prop {#1/translation} \l_tmpa_tl
      { \footnote{\l_tmpa_tl} }
  }

\cs_new_protected:Npn \interlinear_after:n #1
  {
    \str_case:VnF \g_interlinear_mode_tl
      {
        {plain}    { }
        {draft}
          { \nobreak\hspace{0.15em}\textsuperscript{\texttt{#1}} }
        {badges}   { \interlinear_badge:n {#1} }
        {inline}   { \interlinear_inline:n {#1} }
        {footnote} { \interlinear_footnote:n {#1} }
        {focus}
          {
            \interlinear_badge:n {#1}
            \clist_if_in:NnT \g_interlinear_focus_clist {#1}
              { \interlinear_inline:n {#1} }
          }
      }
      { \interlinear_badge:n {#1} }
  }

\cs_new_protected:Npn \interlinear_tag:n #1
  {
    \regex_match:nnTF {\A[A-Za-z0-9]{4}\Z} {#1}
      {
        \seq_if_in:NnTF \g_interlinear_source_labels_seq {#1}
          { \msg_error:nnn {interlinear} {duplicate-tag} {#1} }
          {
            \seq_gput_right:Nn \g_interlinear_source_labels_seq {#1}
            \interlinear_after:n {#1}
          }
      }
      { \msg_error:nnn {interlinear} {invalid-id} {#1} }
  }

\NewDocumentCommand{\itag}{m}{\interlinear_tag:n {#1}}

\NewDocumentCommand{\InterlinearPrintAppendix}{}
  {
    \section*{Annotation~appendix}
    \seq_map_inline:Nn \g_interlinear_source_labels_seq
      {
        \par\medskip\noindent
        \hypertarget{interlinear-ann-##1}{\textbf{\texttt{##1}}}
        \begingroup\raggedright\interlinear_rows:n {##1}\par\endgroup
      }
  }

\AtBeginDocument
  { \InputIfFileExists{\jobname.interlinear.tex}{}{} }
\ExplSyntaxOff
