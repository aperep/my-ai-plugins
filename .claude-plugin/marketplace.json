{
  "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
  "name": "aperep",
  "description": "Personal skill sets, enabled per repository on demand.",
  "owner": {
    "name": "Alexander Perepechko",
    "url": "https://github.com/aperep"
  },
  "metadata": {
    "pluginRoot": "./plugins"
  },
  "plugins": [
    {
      "name": "meta",
      "source": "./meta",
      "description": "Rules for self-modifying: editing skills, plugins, and this marketplace.",
      "category": "meta",
      "tags": ["skills", "plugins", "config"]
    },
    {
      "name": "latex",
      "source": "./latex",
      "description": "LaTeX proofreading, journal style, formulas.",
      "category": "writing",
      "tags": ["latex", "mathematics", "proofreading"]
    },
    {
      "name": "biblio",
      "source": "./biblio",
      "description": "Bibliography and everything related.",
      "category": "writing",
      "tags": ["bibtex", "references", "citations"]
    },
    {
      "name": "obsidian",
      "source": "./obsidian",
      "description": "Working with Obsidian vaults.",
      "category": "writing",
      "tags": ["obsidian", "notes", "markdown"]
    },
    {
      "name": "typst",
      "source": "./typst",
      "description": "Working with Typst, a lightweight LaTeX alternative.",
      "category": "writing",
      "tags": ["typst", "typesetting"]
    }
  ],
  "renames": {}
}
